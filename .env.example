# ==========================================================
# onlyoffice-nextcloud-stack
# Choose ONE mode block below:
# - Mode A: HTTP over IP + two ports (simple LAN demo, default)
# - Mode B: HTTPS with domain + reverse proxy
#
# Run with: ./scripts/up.sh
# ==========================================================

TZ=UTC
DATA_ROOT=./.data

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-strong-password

MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

ONLYOFFICE_JWT_SECRET=change-me-super-long-random-secret

# Resource limits (adjust to your VM)
DB_CPUS=1.0
DB_MEM_LIMIT=1g
DB_PIDS_LIMIT=256

REDIS_CPUS=0.5
REDIS_MEM_LIMIT=512m
REDIS_PIDS_LIMIT=256

NEXTCLOUD_CPUS=2.0
NEXTCLOUD_MEM_LIMIT=2g
NEXTCLOUD_PIDS_LIMIT=512

ONLYOFFICE_CPUS=2.0
ONLYOFFICE_MEM_LIMIT=3g
ONLYOFFICE_PIDS_LIMIT=512

CADDY_CPUS=0.5
CADDY_MEM_LIMIT=512m
CADDY_PIDS_LIMIT=256

# Docker log rotation per container
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Backup controls
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=14

# ==========================================================
# LDAP / Active Directory integration (optional)
# ==========================================================
ENABLE_LDAP=false
LDAP_CONFIG_ID=s01
LDAP_HOST=10.211.55.10
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_START_TLS=false
LDAP_TLS_SKIP_VERIFY=true
LDAP_BIND_USER=Administrator@EVMS.BSTU.EDU
LDAP_BIND_PASSWORD=change-me-ldap-password
LDAP_BASE_DN=DC=evms,DC=bstu,DC=edu
# Optional overrides (if empty, LDAP_BASE_DN is used)
LDAP_USER_BASE_DN=
LDAP_GROUP_BASE_DN=
# Optional advanced filters (AD defaults are applied when empty)
LDAP_USER_FILTER=
LDAP_GROUP_FILTER=
LDAP_LOGIN_FILTER=
LDAP_GROUP_MEMBER_ASSOC_ATTR=member
LDAP_ATTRIBUTES_FOR_GROUP_SEARCH=cn
LDAP_NESTED_GROUPS=false

# ==========================================================
# Mode A (HTTP over IP + ports) - RECOMMENDED FOR LAN DEMO
# ==========================================================
APP_BIND_ADDRESS=0.0.0.0
NEXTCLOUD_PORT=8080
ONLYOFFICE_PORT=8090
PUBLIC_SERVER_IP=192.168.1.50
# Caddy host ports (not required for direct HTTP 8080/8090 access,
# used when ENABLE_CADDY=true)
HTTP_PORT=80
HTTPS_PORT=443

CADDY_SITE_SCHEME=http
ENABLE_CADDY=false
CADDY_GLOBAL_OPTION=
ACME_EMAIL=local@example.com

# Optional overrides (normally do NOT need these in HTTP mode):
# NEXTCLOUD_PUBLIC_URL=http://192.168.1.50:8080
# ONLYOFFICE_PUBLIC_URL=http://192.168.1.50:8090
NEXTCLOUD_FQDN=localhost
ONLYOFFICE_FQDN=localhost
NEXTCLOUD_TRUSTED_DOMAINS=192.168.1.50
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12

# ==========================================================
# Mode B (HTTPS with domain + reverse proxy) - OPTIONAL
# Comment out Mode A values above, then use below.
# ==========================================================
# APP_BIND_ADDRESS=127.0.0.1
# NEXTCLOUD_PORT=18080
# ONLYOFFICE_PORT=18090
# HTTP_PORT=80
# HTTPS_PORT=443
#
# CADDY_SITE_SCHEME=https
# ENABLE_CADDY=true
# CADDY_GLOBAL_OPTION=local_certs
# ACME_EMAIL=admin@example.com
#
# NEXTCLOUD_PUBLIC_URL=https://cloud.localhost
# ONLYOFFICE_PUBLIC_URL=https://docs.localhost
# NEXTCLOUD_FQDN=cloud.localhost
# ONLYOFFICE_FQDN=docs.localhost
# NEXTCLOUD_TRUSTED_DOMAINS=cloud.localhost
# NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
